# 이 파일을 .env 로 복사한 뒤 값을 바꿔서 사용합니다.
# .env 는 Git에 올리지 않습니다. (비밀번호가 들어가기 때문)
# 8장 전용 MySQL 컨테이너(chapter08-mysql, 포트 3308)용 설정입니다.
MYSQL_DATABASE=shopdb
MYSQL_USER=shopuser
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
